  </DataSources>
  <DataSets>
    <DataSet Name="Receipt">
      <Query>
        <DataSourceName>MuseumPOS</DataSourceName>
        <CommandText>SELECT a.UPC, a.ReceiptID, a.Description, b.InvName, a.Price, a.Paid, b.InvUPC, a.TaxPaid, a.Quantity, a.TaxRate, a.ReceiptDateTime, b.Department, b.Vendor, b.InvType
FROM     Receipt AS a LEFT OUTER JOIN
                  InventoryItems AS b ON a.UPC = b.InvUPC
ORDER BY a.ReceiptID</CommandText>
      </Query>
      <Fields>
        <Field Name="UPC">
          <DataField>UPC</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ReceiptID">
          <DataField>ReceiptID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
