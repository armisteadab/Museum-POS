  <DataSets>
    <DataSet Name="Receipt">
      <Query>
        <DataSourceName>MuseumPOS</DataSourceName>
        <CommandText>SELECT a.UPC, a.ReceiptID ,a.Description, b.InvName, a.Price, a.paid, b.InvUPC, a.TaxPaid, a.Quantity, a.TaxRate FROM Receipt a LEFT JOIN InventoryItems b ON a.UPC = b.InvUPC WHERE a.ReceiptID = 23 </CommandText>
      </Query>
      <Fields>
        <Field Name="UPC">
          <DataField>UPC</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Price">
