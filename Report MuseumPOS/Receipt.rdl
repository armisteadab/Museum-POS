  <DataSources>
    <DataSource Name="MuseumPOS">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename="C:\Users\armis\source\repos\MuseumPOS\Museum POS\MuseumPOS\MuseumPOS.mdf";Connect Timeout=30</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>0ee980a0-14c1-449b-a7f6-8ea1557c47a5</rd:DataSourceID>
